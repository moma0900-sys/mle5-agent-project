# Groq by default; alternatives: mistral, openrouter, google, openai, dry-run (offline).
# A live provider requires its own key. Other providers are never called.
LLM_PROVIDER=groq

# Groq (primary)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Mistral (alternative)
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-14b-latest

# OpenRouter (optional). Free-account quotas: https://openrouter.ai/pricing
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Leave blank to disable OpenRouter's server-side model backup.
OPENROUTER_FALLBACK_MODEL=openrouter/free

# Google AI Studio (optional). Use only non-sensitive exercise data on the free tier.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-4-26b-a4b-it

# OpenAI (optional, paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

TOP_K=3
MIN_SCORE=0.18
# Live runs count model requests separately from application tools.
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=6
